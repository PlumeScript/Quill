use #future(all)

init: macro(env, plumePath)
	set self.random = $Random()
	set self.path = do
		let main = $ os.Path(env or os.getEnv("PLUME_DEFAULT_ENV") or plumePath.."lib")
		main:   $ main
		config: $ main / ".quill"
		temp:   $ main / ".quill" / "temp"
		index:  $ main / ".quill" / "index" / "index.plume"
		env:    $ main / "env.plume"	
	end

	run $print(Loading env from $self.path.main)

	if not self.path.env.exists()
		@self.path.env.write()
			packages\: \$Table()
		end
	end

	if not self.path.config.exists()
		$self.path.config.mkdir()
	end

	let const tryEnv = $ attempt(self.path.env.import)	

	if not tryEnv.success
		raise cannot load environnement: $tryEnv.result
	end

	set self.env = $tryEnv.result
end

getTempPath: macro()
	$ self.path.temp / self.random(1000000,9999999)
end

defaultPackage: do
plumeVersion\: $plume.VERSION\n
raw[
name: // package name used for import
author:
description:
version: 1.0.0
source: // url of a .git repo
required: do
	// packageName: do
	// 	version: >1.0.0
	// 	source:
	// end
end
]end
end

help: do
	Quill - the Plume🪶 package manager
	\n
	
	\nquill init [--f]
	\n\tCreate a new `package.plume`. Use `--f` to overwrite existing file.

	\nquill help
	\n\tShow this message and exits.
end