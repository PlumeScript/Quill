use #future(all)

let git = $import(./git)

loadEnv: macro(path)
	run $print(Loading env from $path)
	if not path.exists()
		run @path.write()
			packages\: \$Table()
		end
	end

	let quillConfigPath = $(path.getParent() / ".quill")
	if not quillConfigPath.exists()
		run $quillConfigPath.mkdir()
	end

	let const pathlib =$ String(path).replace(".plume", "")
	let const tryEnv = $ attempt(import, pathlib)
	

	if not tryEnv.success
		raise cannot load environnement: $tryEnv.result
	end

	run $git.getIndex($path)

	$tryEnv.result
end

defaultPackage: do
plumeVersion\: $plume.VERSION\n
raw[
name: // package name used for import
author:
description:
version: 1.0.0
source: // url of a .git repo
required: do
	// packageName: do
	// 	version: >1.0.0
	// 	source:
	// end
end
]end
end

help: do
	Quill - the Plume🪶 package manager
	\n
	
	\nquill init [--f]
	\n\tCreate a new `package.plume`. Use `--f` to overwrite existing file.

	\nquill help
	\n\tShow this message and exits.
end