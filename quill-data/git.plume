use #future(all)
let config = $import(./config)

// Execute a command, use a lua workaround to get the error code
macro exec(String cmd)
	run $print(Executing $cmd)
	let const execution = @lua.eval
		local cmd = [[$cmd]]\n
		raw[
			local handle = io.popen(cmd .. " 2>&1")
			if not handle then
				return "1\ncould not run: " .. cmd
			end
			local out = handle:read("*a")
			local ok = handle:close()
			if not ok then
				return "1\n "..out
			end
			return "0\n "..out
		]end
	end

	let const code, _, result = $execution.partition(\n)

	if code == 1
		raise $result
	end

	$result
end

// get the list of tags of a repo
ref getTags: macro (String url)
	run $print(Getting tags for $url)
	let const rq = $exec(git ls-remote --tags "$url")
	for line in rq.lines()
		let value, _, key = $line.partition(\trefs/tags/)
		set key = $key.replace(^{},)
		$key: $value
	end
end

get: macro(String url, String sha, env)
	run $print(Cloning $url at $sha)
	let tempPath    = $config.getTempPath()
	let packagePath = $ tempPath / "package.plume"
	let archivePath = $ tempPath / "out.tar"

	run do
		if tempPath.exists()
			$tempPath.remove()
		end
		$exec(git init $tempPath)
		$exec(git   -C $tempPath remote add origin $url)
		$exec(git   -C $tempPath fetch --depth 1 origin $sha)
		$exec(git   -C $tempPath show FETCH_HEAD:package.plume > $packagePath)
	end

	let package   = $packagePath.import()
	let name      = $package.name
	run $print(Installing $name)
	let finalPath = $(env / name)

	run do
		if not finalPath.exists()
			$finalPath.mkdir()
		end
		$exec(git -C $tempPath archive --format=tar FETCH_HEAD -o $archivePath)
		$exec(tar -xf $archivePath -C $finalPath)
	end
	
	$package
end

getIndex: macro()
	let indexDir = $ config.path.index.getParent()
	run $print(Updating index at $indexDir)
	if not indexDir.exists()
		$exec(git init $indexDir)
		$exec(git   -C $indexDir remote add origin $("https://github.com/PlumeScript/index"))
	end
	$exec(git   -C $indexDir fetch --depth 1 origin main)
	$exec(git   -C $indexDir show FETCH_HEAD:index.plume > $(config.path.index))
end