use #future(all)
let param ...args
let param plumePath
let param env

let config = $import(./config)
$ config.init(env, plumePath)
let git    = $import(./git)
$ git.getIndex()
let utils  = $import(./utils)

let runningPackages = $Table()

let commands = do
	init: macro(?f)
		let path = $os.Path(package.plume)
		if path.exists() and not f
			Error\: a `package.plume` file already exists. Use `quill init --f` to ignore it.
		else
			$path.write($config.defaultPackage)
			`package.plume` created.
		end
	end

	help: macro()
		$config.help
	end

	add: macro(name, versionSelector:, first: $true)
		if runningPackages[name]?
			raise Infinite loop detected. Abort.
		end

		set runningPackages[name] = $true

		$print(Resolving $name)
		let url  = $ utils.resolveName(name)
		$print(Resolved $name to $url)
		let tags = $ git.getTags(url)

		let versions  = $ utils.findMatchingVersions(tags, versionSelector)
		if len(versions) == 0
			raise Cannot find version of '$name' that satisfies '$versionSelector'.
		end
		let version, sha = $versions[1]

		$print(Installing $name version $version)
		let package = $ git.get(url, sha, config.path.main)
		set package.sha = $sha
		set config.env.packages[package.name] = $package
		
		for _, infos in items(package.required or Table())
			$ commands.add(infos.source, versionSelector: infos.version, first: false)
		end

		if first
			$ config.path.env.write(repr(config.env, ?pretty))
		end

		$ Table.removeKey(runningPackages, name)
	end
end

let commandName = $ Table.remove(args, 1)
let command     = $commands[commandName]?

if command
	$command(...args)
elseif commandName
	Error\: Unknown $commandName.
else
	$commands.help()
end