use #future(all)
let param ...args
let param plumePath
let param env

let git    = $import(./git)
let config = $import(./config)

let envPath = $os.Path($(env or os.getEnv("PLUME_DEFAULT_ENV") or plumePath.."lib"))
let envConfigPath = $(envPath / "env.plume")
let quillConfigPath = $(envPath / ".quill")

let commands = do
	init: macro(?f)
		let path = $os.Path(package.plume)
		if path.exists() and not f
			Error\: a `package.plume` file already exists. Use `quill init --f` to ignore it.
		else
			$path.write($config.defaultPackage)
			`package.plume` created.
		end
	end

	help: macro()
		$config.help
	end

	add: macro(name, versionSelector:)
		// let url = $ resolveName(name)
		let url  = $ name
		let env  = $ config.loadEnv(envConfigPath)
		let tags = $ git.getTags(url)

		// let version, sha  = $ findMatchingVersion(tags, versionSelector)
		let version, sha = $ Table.entry(tags, Table.count(tags, ?named))

		let package = $ git.get(url, sha, envPath)
		set package.sha = $sha
		set env.packages[package.name] = $package
		$ envConfigPath.write(repr(env, ?pretty))
	end
end

let commandName = $ Table.remove(args, 1)
let command     = $commands[commandName]?

if command
	$command(...args)
elseif commandName
	Error\: Unknown $commandName.
else
	$commands.help()
end