use #future(all)
let config = $import(./config)

resolveName: macro(name)
	run $print(Resolving $name)
	if name.find("^https://", ?rich)
		$name
	elseif name.find("^.-%.", ?rich)
		https\:\//$name
	else
		let index = $config.path.index.import()
		if index[name]?
			let url = $index[name]
			if not url.find("^https://", ?rich)
				set url = https\:\//$url
			end
			$url
		else
			raise Cannot find any package named "$name". Check for typo, or give full repo url.
		end
	end
end